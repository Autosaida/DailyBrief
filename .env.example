# =============================================================================
# DailyBrief — environment configuration
# =============================================================================
# Copy this file to .env.local and edit. .env.local is gitignored.

# -----------------------------------------------------------------------------
# Optional outbound proxy
# -----------------------------------------------------------------------------
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# LLM backend selector  (default: claude-cli)
# -----------------------------------------------------------------------------
# Supported: claude-cli | anthropic | openai | deepseek | minimax | zhipu
# LLM_BACKEND=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.6-flash

# Provider-specific overrides (take precedence over LLM_API_KEY / LLM_BASE_URL)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MINIMAX_API_KEY=
# ZHIPU_API_KEY=

# -----------------------------------------------------------------------------
# OpenAlex API key (free $1/day personal budget: https://openalex.org/settings/api)
# -----------------------------------------------------------------------------
# Recommended to avoid shared anonymous IP rate limits on GitHub Actions.
# OPENALEX_API_KEY=

# -----------------------------------------------------------------------------
# Daily email notification via Resend (https://resend.com)
# -----------------------------------------------------------------------------
# Optional — skipped cleanly if RESEND_API_KEY or MAIL_TO is unset.
# RESEND_API_KEY=re_...
# MAIL_TO=you@example.com
# MAIL_FROM=Blockchain Daily Brief <onboarding@resend.dev>
# SITE_URL=https://<your-username>.github.io/<repo-name>/

# -----------------------------------------------------------------------------
# Report timezone & output options
# -----------------------------------------------------------------------------
# REPORT_LOCALE=zh
# REPORT_TZ=Asia/Shanghai
# OUTPUT_MARKDOWN=true

# -----------------------------------------------------------------------------
# Debug / backfill date overrides (optional; default is previous calendar day)
# -----------------------------------------------------------------------------
# ARXIV_TARGET_DATE=2026-11-18
# OPENALEX_TARGET_DATE=2026-01-29
# NEWS_TARGET_DATE=2026-11-23
